#!/usr/bin/env python3
"""wend: the one command for agents and humans working in this repo. Start with AGENTS.md.

  ./wend check                              schema check + the gate's own tests (seconds, no root)
  ./wend list                               routes, boxes and wanted routes
  ./wend replay ROUTE BOX [--steps FILE]    replay a route on a box with no model, write the run   (root)
                                            --steps: also save every command and its output
  ./wend discover FAMILY FROM TO BOX        walk FROM->TO on BOX; a model fills in hops that break   (root, WEND_MODEL)
  ./wend report RUN.json [--redact WORD]    a route broke and you won't fix it yourself: build a scrubbed gap report,
                                            show it, print a prefilled issue link. Sends nothing.
  ./wend gaps ROUTE BOX | --packages FILE | --all
                                            what AlmaLinux's leapp-data says changes on the box at each hop that no
                                            fix in the route names. Report only (tools/pesgaps.py)   (root, but not --packages)
  ./wend verify [--base REF | --all]        exactly what CI runs: check, replay what changed where it starts, decoys
                                            writes .wend/pr-evidence.md for the PR body                 (root)

ROUTE is a path like routes/debian/etch-to-trixie.toml; BOX is an id like debian/etch-web.
Python 3.11+, standard library only. The sandbox needs root, chroot, unshare and rsync, plus debootstrap for Debian
boxes or rpm2cpio, cpio, curl and ip (iproute2) for EL boxes.
"""
import contextlib
import glob
import json
import os
import shutil
import subprocess
import sys
import tomllib

ROOT = os.path.dirname(os.path.abspath(__file__))
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(ROOT, "tools"))
import check  # noqa: E402
from tomlw import toml  # noqa: E402


class Repo:
    def __init__(self):
        self.raw = {os.path.relpath(p, ROOT): open(p, "rb").read() for p in
                    glob.glob(f"{ROOT}/adapters/*.toml") + glob.glob(f"{ROOT}/fixes/*/*/*.toml") +
                    glob.glob(f"{ROOT}/routes/*/*.toml") + glob.glob(f"{ROOT}/boxes/*/*/box.toml")}
        load = lambda prefix: {p: tomllib.loads(b.decode()) for p, b in self.raw.items() if p.startswith(prefix)}
        self.adapters = {os.path.basename(p)[:-5]: d for p, d in load("adapters/").items()}
        self.fixes = load("fixes/")
        self.fixes_by_id = {check.content_id(d): d for d in self.fixes.values()}
        self.fix_path = {check.content_id(d): p for p, d in self.fixes.items()}
        self.routes = load("routes/")
        self.boxes = {p[len("boxes/"):-len("/box.toml")]: d for p, d in load("boxes/").items()}


HOST_TOOLS = {"debian": ["debootstrap"], "ubuntu": ["debootstrap"], "el": ["rpm2cpio", "cpio", "curl", "ip"]}
APT_NAMES = {"ip": "iproute2", "unshare": "util-linux"}


@contextlib.contextmanager
def root_umask():
    """SPEC "How a hop runs": everything the harness runs or writes in a root gets umask 022, whatever the caller's is
    (AlmaLinux 10 root sessions default to 077, and files a fix creates must be readable by daemons). Only the work on
    the root: run files, step logs and reports are written under the caller's mask again."""
    old = os.umask(0o022)
    try:
        yield
    finally:
        os.umask(old)


def need_root(families=("debian",)):
    if os.geteuid() != 0:
        sys.exit("the sandbox needs root (chroot, mount). Run with sudo, in a throwaway VM or CI runner.")
    import shutil
    missing = [t for t in ["chroot", "rsync", "mount", "unshare"] + [x for f in families for x in HOST_TOOLS.get(f, [])]
               if not shutil.which(t)]
    if missing:
        sys.exit(f"missing on this host: {', '.join(missing)} (Debian/Ubuntu: apt-get install "
                 f"{' '.join(sorted({APT_NAMES.get(t, t) for t in missing}))})")


def save_run(run, out=None):
    route_name = next((os.path.basename(p)[:-5] for p, d in Repo().routes.items()
                       if check.content_id(d) == run["route"]), run["route"][7:19])
    fam, box = run["box"].split("/")
    # runs/ holds only CI's attested runs (CONTRIBUTING.md, "How runs land"): a local run is evidence, kept under .wend/
    out = os.path.abspath(out) if out else f"{ROOT}/.wend/runs/{fam}/{route_name}/{box}/{run['started']}.json"
    os.makedirs(os.path.dirname(out), exist_ok=True)
    json.dump(run, open(out, "w"), indent=1)
    open(out, "a").write("\n")
    return out


def summary(run):
    fired = sum(len(h["fired"]) for h in run["hops"])
    s = (f"{run['result'].upper()}: {run['box']} reached {run['final']['release']} "
         f"({len(run['hops'])} hops, {fired} fixes fired, {run['wall_seconds'] // 60} min")
    s += f", {run['model_calls']} model calls)" if run.get("model_calls") else ")"
    if run["final"]["failed"]:
        s += f"; failing checks: {', '.join(run['final']['failed'])}"
    return s


def cmd_replay(route_path, box, out=None, keep=False, steps=None):
    need_root([box.split("/")[0]])
    import fetched
    import walk
    repo = Repo()
    w = None
    since = fetched.mark()
    try:
        with root_umask():
            w = walk.Walk(repo, repo.routes[route_path], box)
            try:
                run = w.walk()
            finally:
                w.close(keep)
    finally:
        if steps and w:
            json.dump(w.steps, open(steps, "w"), indent=1)
    p = save_run(run, out)
    try:  # docs/archive.md "Capture": never changes a replay's outcome
        n = fetched.collect(since, (p[:-len(".json")] if p.endswith(".json") else p) + ".fetched")
    except Exception as e:
        n = 0
        print(f"warning: no download list written: {e}", file=sys.stderr)
    print(summary(run), "\nrun:", os.path.relpath(p, ROOT) + (f" (and {n} fetched files listed beside it)" if n else ""))
    return 0 if run["result"] == "pass" else 1


def cmd_discover(family, frm, to, box, max_calls=12):
    need_root([family])
    import discover
    import models
    import walk
    provider = models.from_env()
    repo = Repo()
    a = repo.adapters[family]
    lad = a["ladder"]
    hops = [r for r in lad[lad.index(frm) + 1: lad.index(to) + 1] if r not in a.get("may_skip", [])]
    rpath = f"routes/{family}/{frm}-to-{to}.toml"
    if rpath not in repo.routes:  # a new route starts with every existing fix of the family on its hops pinned
        repo.routes[rpath] = {"schema": "wend.route/0", "family": family, "arch": repo.boxes[box].get("arch", "amd64"),
                              "from": frm, "to": to, "hops": hops, "finish": {"prune_obsolete": True},
                              "fixes": [{"id": i, "name": f["meta"]["name"]} for i, f in repo.fixes_by_id.items()
                                        if f["family"] == family and f["hop"] in hops],
                              "meta": {"name": f"{frm}-to-{to}"}}
    route = repo.routes[rpath]
    d = discover.Discoverer(provider, max_calls)
    with root_umask():
        w = walk.Walk(repo, route, box)
        try:
            run = w.walk(d)
        finally:
            w.close()
    # new fixes become files and get pinned; existing fixes that fired here now claim this box (meta only: same id)
    for f in d.added:
        p = f"fixes/{family}/{f['hop']}/{f['meta']['name']}.toml"
        if os.path.exists(f"{ROOT}/{p}"):
            f["meta"]["name"] += "-" + check.content_id(f)[7:13]
            p = f"fixes/{family}/{f['hop']}/{f['meta']['name']}.toml"
        os.makedirs(os.path.dirname(f"{ROOT}/{p}"), exist_ok=True)
        open(f"{ROOT}/{p}", "w").write(toml(f, f"# Discovered by {f['meta']['author']} on {box}."))
        route["fixes"].append({"id": check.content_id(f), "name": f["meta"]["name"]})
        print("new fix:", p)
    fired = {i for h in run["hops"] for i in h["fired"]}
    for i in fired & set(repo.fix_path):
        f = repo.fixes_by_id[i]
        if box not in f["meta"].get("fires_on", []):
            f["meta"]["fires_on"] = sorted(f["meta"].get("fires_on", []) + [box])
            text = open(f"{ROOT}/{repo.fix_path[i]}").read()
            open(f"{ROOT}/{repo.fix_path[i]}", "w").write(_set_fires_on(text, f["meta"]["fires_on"]))
            print("now claims", box + ":", repo.fix_path[i])
    os.makedirs(os.path.dirname(f"{ROOT}/{rpath}"), exist_ok=True)  # a family's first route
    open(f"{ROOT}/{rpath}", "w").write(toml(route, "# Every fix is pinned by content id. ./wend check --repin after editing fixes."))
    run["route"] = check.content_id(route)
    p = save_run(run)
    print(summary(run), "\nroute:", rpath, "\nrun:", os.path.relpath(p, ROOT))
    if run["result"] == "pass":
        print("next: ./wend verify, then open a PR (AGENTS.md step 6)")
    return 0 if run["result"] == "pass" else 1


def _set_fires_on(text, boxes):
    line = f"fires_on = {json.dumps(boxes)}"
    lines = text.splitlines()
    for n, l in enumerate(lines):
        if l.startswith("fires_on ="):
            lines[n] = line
            return "\n".join(lines) + "\n"
    return text.rstrip("\n") + "\n" + line + "\n"  # [meta] is the last table in every fix file


def cmd_verify(base=None, all_=False, jobs=2):
    # no root_umask here: verify only runs replays, as child processes that set it for their own walk
    if subprocess.run([sys.executable, "-B", f"{ROOT}/tools/check.py"]).returncode or \
            subprocess.run([sys.executable, "-B", f"{ROOT}/tools/test_check.py"], stdout=subprocess.DEVNULL).returncode:
        print("schema check failed; fix that first")
        return 1
    repo = Repo()
    need_root({d["family"] for d in repo.boxes.values()})
    if all_ or not base:
        matrix = [{"route": r, "box": b} for r, d in repo.routes.items() for b, x in repo.boxes.items()
                  if check.starts(x, d)]
    else:
        r = subprocess.run([sys.executable, "-B", f"{ROOT}/tools/affected.py", base], capture_output=True, text=True)
        if r.returncode:
            print(r.stderr.strip() or "tools/affected.py failed")
            return 1
        matrix = json.loads(r.stdout)["include"]
    if not matrix:
        print("nothing to replay: the change touches no route, fix, box or adapter")
        return 0
    shutil.rmtree(f"{ROOT}/.wend/verify", ignore_errors=True)  # only this verify's runs count as its evidence
    os.makedirs(f"{ROOT}/.wend/verify", exist_ok=True)
    print(f"replaying {len(matrix)} route x box pairs, {jobs} at a time (about 15 min each)")
    results, queue, running = [], list(matrix), []
    while queue or running:
        while queue and len(running) < jobs:
            m = queue.pop(0)
            out = f"{ROOT}/.wend/verify/{m['route'].replace('/', '_')}--{m['box'].replace('/', '_')}.json"
            log = open(out[:-5] + ".log", "w")
            running.append((m, out, subprocess.Popen([sys.executable, "-P", "-B", __file__, "replay", m["route"], m["box"],
                                                      "--out", out], stdout=log, stderr=subprocess.STDOUT)))
        for item in list(running):
            if item[2].poll() is not None:
                running.remove(item)
                m, out, _ = item
                run = json.load(open(out)) if os.path.exists(out) else None
                results.append((m, out, run))
                print(summary(run) if run else f"CRASHED: {m} (see {out[:-5]}.log)")
        if running:
            import time
            time.sleep(5)
    # the decoy check over these fresh runs too; they stay in .wend/ (runs/ takes only CI's attested runs)
    rc = subprocess.run([sys.executable, "-B", f"{ROOT}/tools/check.py", "--also-runs",
                         f"{ROOT}/.wend/verify"]).returncode
    ok = rc == 0 and all(r and r["result"] == "pass" for _, _, r in results)
    lines = ["## Evidence (from `./wend verify`)", "", "| route | box | result | reached | fixes fired | minutes |",
             "|---|---|---|---|---|---|"]
    for m, out, r in results:
        lines.append(f"| {m['route']} | {m['box']} | {r['result'] if r else 'crashed'} | "
                     f"{r['final']['release'] if r else ''} | {sum(len(h['fired']) for h in r['hops']) if r else ''} | "
                     f"{r['wall_seconds'] // 60 if r else ''} |")
    lines += ["", "Decoy check: " + ("passed" if rc == 0 else "FAILED, see `./wend check` output")]
    open(f"{ROOT}/.wend/pr-evidence.md", "w").write("\n".join(lines) + "\n")
    print(("VERIFIED" if ok else "NOT VERIFIED") + ": evidence for the PR body is in .wend/pr-evidence.md")
    return 0 if ok else 1


def cmd_list():
    repo = Repo()
    print("routes:")
    for p, d in repo.routes.items():
        print(f"  {p}  ({len(d['fixes'])} fixes)")
    print("boxes:")
    for b, d in repo.boxes.items():
        print(f"  {b}  {d.get('summary', '')}")
    if os.path.exists(f"{ROOT}/wanted.toml"):
        print("wanted (claim one by opening its issue and commenting 'claim'; see AGENTS.md):")
        for w in tomllib.load(open(f"{ROOT}/wanted.toml", "rb"))["wanted"]:
            print(f"  [{w['status']}] {w['family']} {w['from']} -> {w['to']}  {w.get('box_idea', '')}")
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    c, rest = argv[0], argv[1:]
    opt = lambda name, default=None: rest[rest.index(name) + 1] if name in rest else default
    if c == "check":
        a = subprocess.run([sys.executable, "-B", f"{ROOT}/tools/check.py", *rest]).returncode
        b = 0 if rest else subprocess.run([sys.executable, "-B", f"{ROOT}/tools/test_check.py"]).returncode
        u = 0 if rest else subprocess.run([sys.executable, "-B", f"{ROOT}/tools/test_umask.py"]).returncode
        g = 0 if rest else subprocess.run([sys.executable, "-B", f"{ROOT}/tools/test_grub.py"]).returncode
        n = 0 if rest else subprocess.run([sys.executable, "-B", f"{ROOT}/tools/test_net_ifcfg.py"]).returncode
        i = 0 if rest else subprocess.run([sys.executable, "-B", f"{ROOT}/tools/test_net_ifupdown.py"]).returncode
        k = 0 if rest else subprocess.run([sys.executable, "-B", f"{ROOT}/tools/test_kernels_apt.py"]).returncode
        e = 0 if rest else subprocess.run([sys.executable, "-B", f"{ROOT}/tools/test_esm_pins.py"]).returncode
        r = 0 if rest else subprocess.run([sys.executable, "-B", f"{ROOT}/tools/test_relocate.py"]).returncode
        p = 0 if rest else subprocess.run([sys.executable, "-B", f"{ROOT}/tools/test_pesgaps.py"]).returncode
        f = 0 if rest else subprocess.run([sys.executable, "-B", f"{ROOT}/tools/test_printf.py"]).returncode
        s = 0 if rest else subprocess.run([sys.executable, "-B", f"{ROOT}/tools/test_checksig.py"]).returncode
        d = 0 if rest else subprocess.run([sys.executable, "-B", f"{ROOT}/tools/test_fetched.py"]).returncode
        v = 0 if rest else subprocess.run([sys.executable, "-B", f"{ROOT}/tools/test_archive.py"]).returncode
        m = 0 if rest else subprocess.run([sys.executable, "-B", f"{ROOT}/tools/test_primary.py"]).returncode
        o = 0 if rest else subprocess.run([sys.executable, "-B", f"{ROOT}/tools/test_r2push.py"]).returncode
        h = 0 if rest else subprocess.run([sys.executable, "-B", f"{ROOT}/tools/test_gate_fetched.py"]).returncode
        q = 0 if rest else subprocess.run([sys.executable, "-B", f"{ROOT}/tools/test_vm_parallel.py"]).returncode
        return a or b or u or g or n or i or k or e or r or p or f or s or d or v or m or o or h or q
    if c == "list":
        return cmd_list()
    if c == "replay":
        return cmd_replay(rest[0], rest[1], opt("--out"), "--keep" in rest, opt("--steps"))
    if c == "discover":
        return cmd_discover(*rest[:4], max_calls=int(opt("--max-calls", 12)))
    if c == "report":
        import report
        return report.main(rest[0], [rest[i + 1] for i, x in enumerate(rest) if x == "--redact"])
    if c == "gaps":
        import pesgaps
        if "--packages" not in rest:
            need_root(["el"])
        return pesgaps.main(Repo(), rest)
    if c == "verify":
        return cmd_verify(opt("--base"), "--all" in rest, int(opt("--jobs", 2)))
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
